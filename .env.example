# Copy to .env.local and fill in. .env* is gitignored.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — bypasses RLS completely.
# The missing NEXT_PUBLIC_ prefix is deliberate: adding it would inline this
# key into the JavaScript bundle shipped to every customer's phone.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: set to "development" locally so the Mock Pay sandbox button works.
# In production it is refused and logged as MOCK_PAY_PROD_TRIGGERED.
